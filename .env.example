
# .env — LOCAL development (used with docker-compose.yml)

#COMPOSE_PROFILES=dev  # Run WITHOUT node (default): leave empty or omit the line entirely, 'dev'  run WITH the node watcher
APP_ENV=local

# --- MySQL ---
MYSQL_HOST=mysql:3306
MYSQL_CONTAINER=default_mysql
MYSQL_DATABASE=default
MYSQL_USER=pablo
MYSQL_PASSWORD=********
MYSQL_ROOT_PASSWORD=********

# --- WordPress  ---
WORDPRESS_CONTAINER=default_wordpress
WORDPRESS_PORT=8080            # optional HTTP listener; unused while Caddy terminates TLS
WORDPRESS_SSL_PORT=8447        # also the public Caddy HTTPS port (all 3 vhosts share it via SNI)
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_HOME=https://default.localhost:8447   # NO trailing slash
WORDPRESS_DEBUG=true
WORDPRESS_THEMENAME=default


# --- phpMyAdmin / WP-CLI ---
PHPMYADMIN_CONTAINER=default_phpmyadmin
WPCLI_CONTAINER=default_wpcli
PHPMYADMIN_PORT=8547           # unused via Caddy (phpMyAdmin is on its own subdomain)

# --- Caddy ---
CADDY_CONTAINER=default_caddy
CADDY_HOSTNAME=default.localhost

# --- Node ---
NODE_PORT=5177

#SAGE_APPURL=https://default.localhost:8458 same as WORDPRESS_HOME
#SAGE_APPHOST=default.localhost same as CADDY_HOSTNAME
#SAGE_THEMENAME=codigo same as WORDPRESS_THEMENAME
